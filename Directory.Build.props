<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.6.0</Version>
    <!-- ICU runtime version bundled with self-contained Linux publish output of CLI tools.
         Single source of truth — referenced by Directory.Packages.props, the three CLI csprojs'
         AppLocalIcu RuntimeHostConfigurationOption, and the release.yml ICU_VERSION env var
         which feeds nfpm.yaml.template. Bump in lockstep with the Microsoft.ICU.ICU4C.Runtime
         package version. -->
    <IcuVersion>72.1.0.3</IcuVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Demo</Configurations>
    <Company>SchemaSmith Contributors</Company>
    <Authors>SchemaSmith Contributors</Authors>
    <Copyright>© SchemaSmith Contributors. Licensed under the SSCL v2.0</Copyright>
  </PropertyGroup>

  <!-- Static-analysis quality gate: SonarAnalyzer runs inside every `dotnet build` (local + CI,
       no separate job). PrivateAssets=all keeps it dev-only — never flows into the packed
       SchemaSmith.Schema NuGet. Being introduced deliberately: measure the finding inventory,
       triage to a curated set, then ratchet the curated rules to error (severity up only). -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Strip PDB files from Release/Demo publish output so ZIPs and MSIs never include them -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
