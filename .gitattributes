# Shell scripts must be LF on every platform — busybox sh and dash
# do not tolerate CR characters. Without this, Windows checkouts with
# core.autocrlf=true would convert LF to CRLF and break install.sh
# in Linux/macOS containers run from a Windows clone.
*.sh text eol=lf

# Windows batch files keep CRLF — cmd.exe expects it.
*.cmd text eol=crlf
*.bat text eol=crlf

# The AUR PKGBUILD is sourced by makepkg (bash) on Linux — CR characters break it.
# It has no extension, so pin it explicitly.
packaging/aur/PKGBUILD text eol=lf


# Encryption test-infra files are consumed by Docker/Linux containers (keyring keys, JSON manifest,
# my.cnf, Dockerfiles) -- a CRLF checkout breaks file_key_management/keyring parsing. Force LF.
scripts/test-infra/encryption/** text eol=lf

# DataDirectory test-infra files (Dockerfiles, my.cnf) are consumed by Docker/Linux containers the same
# way -- a CRLF checkout breaks my.cnf parsing. Force LF.
scripts/test-infra/datadir/** text eol=lf
