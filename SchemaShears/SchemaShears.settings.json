{
    "SourcePath": "",        // Full product folder to carve the patch from
    "ManifestPath": "",      // File listing product-relative paths to include (one per line; # comments allowed)
    "AlwaysIncludePath": "", // Optional: file listing paths/folders always included regardless of the manifest
    "OutputPath": "",        // Destination folder for the patch package
    "Zip": false,            // Also produce <OutputPath>.zip
    "AllowDrops": ""         // Comma-separated drop categories to leave enabled (e.g. "Columns,Indexes"); empty suppresses all drops
    // "LogHygiene": { "ScrubTokens": [ "ApiKey" ] }, // Extra setting names whose values are masked in the log, beyond the built-in sensitive-name list.
    // "ExitNonZeroOnWarning": false // Exit 1 instead of 0 when the run logged a warning, for pipelines that treat warnings as failures. Also the --ExitNonZeroOnWarning switch.
}
