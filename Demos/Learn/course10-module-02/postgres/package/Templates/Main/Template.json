{
  "$schema": "../../.json-schemas/templates.postgresql.schema",
  "Name": "Main",
  "DatabaseIdentificationScript": "SELECT datname FROM pg_database WHERE datname = 'learn'",
  "ScriptFolders": [
    {
      "FolderPath": "Programmability/Modern",
      "QuenchSlot": "AfterTablesObjects",
      "ObjectType": "Views",
      "ShouldApplyExpression": "{{ServerMajorVersion}} >= 16"
    },
    {
      "FolderPath": "Programmability/Legacy",
      "QuenchSlot": "AfterTablesObjects",
      "ObjectType": "Views",
      "ShouldApplyExpression": "{{ServerMajorVersion}} < 16"
    }
  ],
  "ScriptTokens": {}
}
