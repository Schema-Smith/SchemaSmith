{
  "$schema": ".json-schemas/products.mariadb.schema",
  "Name": "Shop",
  "ValidationScript": "SELECT EXISTS(SELECT * FROM information_schema.schemata WHERE SCHEMA_NAME = '{{MainDb}}')",
  "TemplateOrder": [
    "Main"
  ],
  "ScriptTokens": {
    "MainDb": "shop_from_flyway"
  },
  "ScriptFolders": [],
  "BranchNameFile": "{{repo_path}}/.git/HEAD",
  "BeforeBranchNameMask": "ref: refs/heads/",
  "AfterBranchNameMask": "",
  "Platform": "MariaDb",
  "DropTablesRemovedFromProduct": true
}