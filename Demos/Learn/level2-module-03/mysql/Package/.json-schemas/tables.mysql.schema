{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional. Relative path to the generated JSON Schema, for editor validation and autocomplete. Ignored at deploy time."
    },
    "Description": {
      "type": "string",
      "description": "Optional. A description stored on the object: an MS_Description extended property on SQL Server, COMMENT ON on PostgreSQL, the COMMENT clause on MySQL and MariaDB. On SQL Server and PostgreSQL an omitted value leaves an existing description alone and \"\" removes it; on MySQL and MariaDB an omitted value clears the comment, as the engine's own DDL does."
    },
    "Name": {
      "type": "string"
    },
    "Columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "DataType": {
            "type": "string"
          },
          "Nullable": {
            "type": "boolean"
          },
          "Default": {
            "type": "string"
          },
          "Description": {
            "type": "string",
            "description": "Optional. A description stored on the object: an MS_Description extended property on SQL Server, COMMENT ON on PostgreSQL, the COMMENT clause on MySQL and MariaDB. On SQL Server and PostgreSQL an omitted value leaves an existing description alone and \"\" removes it; on MySQL and MariaDB an omitted value clears the comment, as the engine's own DDL does."
          },
          "ShouldApplyExpression": {
            "type": "string"
          },
          "OldName": {
            "type": "string"
          },
          "VariantName": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
          },
          "GenerationExpression": {
            "type": "string"
          },
          "AutoIncrement": {
            "type": "boolean"
          },
          "Generated": {
            "type": "string",
            "pattern": "^(?:STORED|VIRTUAL)$"
          },
          "CharacterSet": {
            "type": "string"
          },
          "Collation": {
            "type": "string"
          },
          "Comment": {
            "type": "string",
            "description": "Deprecated alias of Description. Still honoured on deploy; --Validate reports it (SS-DESC-002)."
          },
          "Invisible": {
            "type": "boolean"
          },
          "Srid": {
            "type": "integer"
          },
          "OnUpdateCurrentTimestamp": {
            "type": "string"
          },
          "Extensions": {}
        },
        "additionalProperties": false,
        "required": [
          "Name",
          "DataType"
        ]
      }
    },
    "Indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "PrimaryKey": {
            "type": "boolean"
          },
          "Unique": {
            "type": "boolean"
          },
          "UniqueConstraint": {
            "type": "boolean"
          },
          "IndexColumns": {
            "type": "string"
          },
          "Description": {
            "type": "string",
            "description": "Optional. A description stored on the object: an MS_Description extended property on SQL Server, COMMENT ON on PostgreSQL, the COMMENT clause on MySQL and MariaDB. On SQL Server and PostgreSQL an omitted value leaves an existing description alone and \"\" removes it; on MySQL and MariaDB an omitted value clears the comment, as the engine's own DDL does."
          },
          "ShouldApplyExpression": {
            "type": "string"
          },
          "VariantName": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
          },
          "IndexType": {
            "type": "string",
            "pattern": "^(?:BTREE|HASH|FULLTEXT|SPATIAL)$"
          },
          "Visible": {
            "type": "boolean"
          },
          "Comment": {
            "type": "string",
            "description": "Deprecated alias of Description. Still honoured on deploy; --Validate reports it (SS-DESC-002)."
          },
          "Extensions": {}
        },
        "additionalProperties": false,
        "required": [
          "Name",
          "IndexColumns"
        ]
      }
    },
    "ForeignKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Columns": {
            "type": "string"
          },
          "RelatedTable": {
            "type": "string"
          },
          "RelatedColumns": {
            "type": "string"
          },
          "DeleteAction": {
            "type": "string",
            "pattern": "^(NO ACTION|RESTRICT|CASCADE|SET NULL|SET DEFAULT)?$"
          },
          "UpdateAction": {
            "type": "string",
            "pattern": "^(NO ACTION|RESTRICT|CASCADE|SET NULL|SET DEFAULT)?$"
          },
          "ShouldApplyExpression": {
            "type": "string"
          },
          "VariantName": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
          },
          "RelatedTableSchema": {
            "type": "string"
          },
          "Extensions": {}
        },
        "additionalProperties": false,
        "required": [
          "Name",
          "Columns",
          "RelatedTable",
          "RelatedColumns"
        ]
      }
    },
    "CheckConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Expression": {
            "type": "string"
          },
          "ShouldApplyExpression": {
            "type": "string"
          },
          "VariantName": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
          },
          "Enforced": {
            "type": "boolean",
            "description": "false declares the constraint NOT ENFORCED: it is kept but not checked. MySQL cannot alter it below 8.0.19, so a change drops and re-creates the constraint. Omitted means enforced. MariaDB has no such state."
          },
          "Extensions": {}
        },
        "additionalProperties": false,
        "required": [
          "Name",
          "Expression"
        ]
      }
    },
    "ShouldApplyExpression": {
      "type": "string"
    },
    "DataDelivery": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ContentFile": {
              "type": "string"
            },
            "MergeType": {
              "type": "string",
              "pattern": "^(?:[Ii][Nn][Ss][Ee][Rr][Tt]|[Ii][Nn][Ss][Ee][Rr][Tt]/[Uu][Pp][Dd][Aa][Tt][Ee]|[Ii][Nn][Ss][Ee][Rr][Tt]/[Uu][Pp][Dd][Aa][Tt][Ee]/[Dd][Ee][Ll][Ee][Tt][Ee])$"
            },
            "MatchColumns": {
              "type": "string"
            },
            "MergeFilter": {
              "type": "string"
            },
            "MergeDisableTriggers": {
              "type": "boolean"
            },
            "ShouldApplyExpression": {
              "type": "string"
            },
            "VariantName": {
              "type": "string",
              "maxLength": 128,
              "description": "Optional label for a conditional data-delivery variant — names the intent behind its ShouldApplyExpression, appears in deployment logging when the delivery applies, and identifies which array variant a DataTongs re-extraction reconciles."
            },
            "ContentEncoding": {
              "type": "string",
              "pattern": "^(?:Json|Xml)$"
            },
            "TimeZone": {
              "type": "string",
              "pattern": "^[+-](0[0-9]|1[0-4]):[0-5][0-9]$",
              "description": "The session time zone (an offset such as +00:00) the ContentFile's TIMESTAMP values were extracted in. Delivery uses the same zone so the values arrive unchanged. DataTongs sets it; leave it unset for data written in the target server's own zone. MySQL and MariaDB only."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ContentFile": {
                "type": "string"
              },
              "MergeType": {
                "type": "string",
                "pattern": "^(?:[Ii][Nn][Ss][Ee][Rr][Tt]|[Ii][Nn][Ss][Ee][Rr][Tt]/[Uu][Pp][Dd][Aa][Tt][Ee]|[Ii][Nn][Ss][Ee][Rr][Tt]/[Uu][Pp][Dd][Aa][Tt][Ee]/[Dd][Ee][Ll][Ee][Tt][Ee])$"
              },
              "MatchColumns": {
                "type": "string"
              },
              "MergeFilter": {
                "type": "string"
              },
              "MergeDisableTriggers": {
                "type": "boolean"
              },
              "ShouldApplyExpression": {
                "type": "string"
              },
              "VariantName": {
                "type": "string",
                "maxLength": 128,
                "description": "Optional label for a conditional data-delivery variant — names the intent behind its ShouldApplyExpression, appears in deployment logging when the delivery applies, and identifies which array variant a DataTongs re-extraction reconciles."
              },
              "ContentEncoding": {
                "type": "string",
                "pattern": "^(?:Json|Xml)$"
              },
              "TimeZone": {
                "type": "string",
                "pattern": "^[+-](0[0-9]|1[0-4]):[0-5][0-9]$",
                "description": "The session time zone (an offset such as +00:00) the ContentFile's TIMESTAMP values were extracted in. Delivery uses the same zone so the values arrive unchanged. DataTongs sets it; leave it unset for data written in the target server's own zone. MySQL and MariaDB only."
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "VariantName": {
      "type": "string",
      "maxLength": 128,
      "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
    },
    "DropColumnsRemovedFromProduct": {
      "type": "boolean",
      "description": "When set, overrides the template- and product-level DropColumnsRemovedFromProduct flag for this table only. Null inherits from the template (or product) setting."
    },
    "DropForeignKeysRemovedFromProduct": {
      "type": "boolean",
      "description": "When set, overrides the template- and product-level DropForeignKeysRemovedFromProduct flag for this table only. Null inherits from the template (or product) setting."
    },
    "DropCheckConstraintsRemovedFromProduct": {
      "type": "boolean",
      "description": "When set, overrides the template- and product-level DropCheckConstraintsRemovedFromProduct flag for this table only. Null inherits from the template (or product) setting."
    },
    "DropIndexesRemovedFromProduct": {
      "type": "boolean",
      "description": "When set, overrides the template- and product-level DropIndexesRemovedFromProduct flag for this table only. Null inherits from the template (or product) setting."
    },
    "OldName": {
      "type": "string"
    },
    "PreventDrop": {
      "type": "boolean",
      "description": "When true, this table is protected from drop-by-absence and the protection is sticky: it is persisted in SchemaSmith's ownership tracking so a protected table that is later removed from the product package is skipped (never silently dropped) rather than reconciled away. Set false and re-deploy while the table is still in the package to clear the protection before an intended removal. Default false."
    },
    "RebuildPolicy": {
      "type": "object",
      "properties": {
        "Mode": {
          "type": "string",
          "pattern": "^\\s*(?:[Nn][Ee][Vv][Ee][Rr]|[Aa][Ll][Ww][Aa][Yy][Ss]|[Tt][Hh][Rr][Ee][Ss][Hh][Oo][Ll][Dd])\\s*$",
          "description": "When to rebuild the table instead of altering it in place. NEVER (the default) always alters in place. ALWAYS rebuilds for any change. THRESHOLD rebuilds once the number of pending changes reaches Threshold, which is then required."
        },
        "Threshold": {
          "type": "integer",
          "minimum": 1.0,
          "description": "Required when Mode is THRESHOLD: the number of pending changes at which the table is rebuilt rather than altered in place. Ignored for every other Mode."
        },
        "OnOrderMismatch": {
          "type": "boolean",
          "description": "Rebuild when the deployed column order does not match the authored column order. An independent trigger that composes with Mode rather than replacing it — a table can ask for both a threshold and an order-mismatch rebuild."
        }
      },
      "additionalProperties": false,
      "description": "When set, overrides the template-, product- and environment-level RebuildPolicy for this table only. Null inherits from the nearest level that declares one. The winning policy applies whole — a policy declared here does NOT pick up fields it omits from a higher level."
    },
    "Engine": {
      "type": "string"
    },
    "RowFormat": {
      "type": "string",
      "pattern": "^(?:[Dd][Yy][Nn][Aa][Mm][Ii][Cc]|[Cc][Oo][Mm][Pp][Aa][Cc][Tt]|[Cc][Oo][Mm][Pp][Rr][Ee][Ss][Ss][Ee][Dd]|[Rr][Ee][Dd][Uu][Nn][Dd][Aa][Nn][Tt]|[Ff][Ii][Xx][Ee][Dd]|[Pp][Aa][Gg][Ee])$"
    },
    "CharacterSet": {
      "type": "string"
    },
    "Collation": {
      "type": "string"
    },
    "Comment": {
      "type": "string",
      "description": "Deprecated alias of Description. Still honoured on deploy; --Validate reports it (SS-DESC-002)."
    },
    "AutoIncrementValue": {
      "type": "integer",
      "minimum": 1.0
    },
    "FullTextIndexes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Columns": {
            "type": "string"
          },
          "Parser": {
            "type": "string"
          },
          "Comment": {
            "type": "string",
            "description": "Deprecated alias of Description. Still honoured on deploy; --Validate reports it (SS-DESC-002)."
          },
          "Description": {
            "type": "string",
            "description": "Optional. The index's COMMENT. An omitted value clears a comment the server has, as the engine's own DDL does."
          },
          "ShouldApplyExpression": {
            "type": "string"
          },
          "VariantName": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
          },
          "Extensions": {}
        },
        "additionalProperties": false,
        "required": [
          "Name",
          "Columns"
        ]
      }
    },
    "Compression": {
      "type": "string",
      "pattern": "^(?:zlib|lz4|none)$",
      "description": "MySQL only. InnoDB transparent page compression for the table's tablespace file. MariaDB spells this PAGE_COMPRESSED instead. MySQL only."
    },
    "KeyBlockSize": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 16.0,
      "description": "InnoDB compressed-page size in KB (1, 2, 4, 8 or 16). Only meaningful with RowFormat = COMPRESSED."
    },
    "Partitioning": {
      "type": "object",
      "properties": {
        "Method": {
          "type": "string",
          "pattern": "^(?:RANGE|LIST|HASH|KEY|LINEAR HASH|LINEAR KEY|RANGE COLUMNS|LIST COLUMNS)$",
          "description": "RANGE, LIST, HASH, KEY, LINEAR HASH, LINEAR KEY, RANGE COLUMNS or LIST COLUMNS. The LINEAR forms take a PartitionCount, as HASH and KEY do."
        },
        "Expression": {
          "type": "string",
          "description": "The partitioning expression, or a comma-separated column list for the COLUMNS methods. Compared with backticks, whitespace and case normalized away, because the engines disagree on how they report it."
        },
        "PartitionCount": {
          "type": "integer",
          "minimum": 1.0,
          "description": "Number of partitions for HASH and KEY. Not used by RANGE or LIST, which name each partition and its boundary explicitly. A HASH or KEY table may name its partitions in Partitions instead, and then the count is how many it names."
        },
        "KeyAlgorithm": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 2.0,
          "description": "KEY partitioning only: ALGORITHM 1 or 2 (the default). Set from extraction when the table uses 1. Not compared on an existing table."
        },
        "Subpartitioning": {
          "type": "object",
          "properties": {
            "Method": {
              "type": "string",
              "pattern": "^(?:HASH|KEY|LINEAR HASH|LINEAR KEY)$",
              "description": "HASH, KEY, LINEAR HASH or LINEAR KEY."
            },
            "Expression": {
              "type": "string",
              "description": "The subpartitioning expression for HASH, or the column list for KEY. Compared normalized, like the partitioning expression."
            },
            "Count": {
              "type": "integer",
              "minimum": 1.0,
              "description": "Subpartitions in each partition."
            },
            "Extensions": {}
          },
          "additionalProperties": false,
          "required": [
            "Method",
            "Expression",
            "Count"
          ]
        },
        "Partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Name": {
                "type": "string",
                "maxLength": 64
              },
              "Values": {
                "type": "string",
                "description": "The VALUES LESS THAN boundary for RANGE, or the VALUES IN list for LIST. Omitted for HASH and KEY, which have no boundary."
              },
              "Comment": {
                "type": "string",
                "maxLength": 1024,
                "description": "The partition's comment. A change on a deployed table is reported, not applied, because the engine reorganizes the partition to change it."
              },
              "Extensions": {}
            },
            "additionalProperties": false,
            "required": [
              "Name"
            ]
          }
        },
        "Extensions": {}
      },
      "additionalProperties": false,
      "required": [
        "Method",
        "Expression"
      ]
    },
    "Encryption": {
      "type": "string",
      "pattern": "^(?:Y|N)$",
      "description": "MySQL only. InnoDB at-rest tablespace encryption ('Y' or 'N'). MariaDB spells this ENCRYPTED=YES/NO instead. MySQL only."
    },
    "Tablespace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_$]+$",
      "description": "MySQL only. The InnoDB general tablespace this table is placed in; applied at create, a move is refused. MySQL only."
    },
    "DataDirectory": {
      "type": "string",
      "pattern": "^[^']+$",
      "description": "The filesystem directory the table's data file is placed in (InnoDB DATA DIRECTORY); applied at create, a move is refused. MySQL requires the directory to be listed in the server's innodb_directories. MySQL and MariaDB only."
    },
    "Extensions": {}
  },
  "additionalProperties": false,
  "required": [
    "Name"
  ]
}