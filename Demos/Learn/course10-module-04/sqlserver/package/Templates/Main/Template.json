{
  "$schema": "../../.json-schemas/templates.sqlserver.schema",
  "Name": "Main",
  "DatabaseIdentificationScript": "SELECT [name] FROM sys.databases WHERE [name] IN ('learn_2022', 'learn_2016', 'learn_2008')",
  "ScriptFolders": [
    {
      "FolderPath": "Shred/Modern",
      "QuenchSlot": "After",
      "ShouldApplyExpression": "{{CompatibilityLevel}} >= 130"
    },
    {
      "FolderPath": "Shred/Legacy",
      "QuenchSlot": "After",
      "ShouldApplyExpression": "{{CompatibilityLevel}} < 130"
    }
  ],
  "ScriptTokens": {}
}
