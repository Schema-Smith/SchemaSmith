{
  "$schema": "../../../.json-schemas/tables.mariadb.schema",
  "Name": "`StatusCode`",
  "Columns": [
    { "Name": "`Code`", "DataType": "CHAR(4)" },
    { "Name": "`Label`", "DataType": "VARCHAR(48)" },
    { "Name": "`Region`", "DataType": "CHAR(6)" }
  ],
  "Indexes": [
    { "Name": "PRIMARY", "PrimaryKey": true, "IndexColumns": "`Code`" }
  ],
  "DataDelivery": [
    {
      "ContentFile": "data/StatusCode.core.tabledata",
      "MergeType": "Insert/Update/Delete",
      "MatchColumns": "`Code`",
      "MergeFilter": "Target.Region = 'GLOBAL'",
      "ShouldApplyExpression": "DATABASE() = 'cookbook_r7_main'",
      "VariantName": "Core status codes"
    },
    {
      "ContentFile": "data/StatusCode.regional.tabledata",
      "MergeType": "Insert/Update/Delete",
      "MatchColumns": "`Code`",
      "MergeFilter": "Target.Region IN ('EMEA','APAC')",
      "ShouldApplyExpression": "DATABASE() = 'cookbook_r7_main'",
      "VariantName": "Regional status codes"
    }
  ]
}
