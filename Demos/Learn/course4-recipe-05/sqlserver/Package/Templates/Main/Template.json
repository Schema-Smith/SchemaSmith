{
  "$schema": "../../.json-schemas/templates.sqlserver.schema",
  "Name": "Main",
  "DatabaseIdentificationScript": "SELECT name FROM sys.databases WHERE name = 'cookbook_r5'",
  "ScriptTokens": {
    "ProductTable": "<*SpecificTable*>dbo.Product",
    "ProductSummaryView": "<*SpecificIndexedView*>dbo.vProductSummary"
  },
  "ScriptFolders": [
    { "FolderPath": "After Scripts", "QuenchSlot": "After" },
    { "FolderPath": "After Scripts-Modern", "QuenchSlot": "After", "ShouldApplyExpression": "{{ServerMajorVersion}} >= 14 AND {{CompatibilityLevel}} >= 130" },
    { "FolderPath": "After Scripts-Legacy", "QuenchSlot": "After", "ShouldApplyExpression": "{{ServerMajorVersion}} < 14 OR {{CompatibilityLevel}} < 130" }
  ]
}
