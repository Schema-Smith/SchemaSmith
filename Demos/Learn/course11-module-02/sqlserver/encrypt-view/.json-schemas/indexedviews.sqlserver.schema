{
  "type": "object",
  "properties": {
    "Name": {
      "type": "string"
    },
    "Schema": {
      "type": "string"
    },
    "Definition": {
      "type": "string"
    },
    "ShouldApplyExpression": {
      "type": "string"
    },
    "VariantName": {
      "type": "string",
      "maxLength": 128,
      "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
    },
    "Indexes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "PrimaryKey": {
            "type": "boolean"
          },
          "Unique": {
            "type": "boolean"
          },
          "UniqueConstraint": {
            "type": "boolean"
          },
          "IndexColumns": {
            "type": "string"
          },
          "ShouldApplyExpression": {
            "type": "string"
          },
          "VariantName": {
            "type": "string",
            "maxLength": 128,
            "description": "Optional label for a conditional variant — names the intent behind its ShouldApplyExpression and appears in deployment logging when the variant is applied."
          },
          "FilterExpression": {
            "type": "string"
          },
          "CompressionType": {
            "type": "string"
          },
          "Clustered": {
            "type": "boolean"
          },
          "ColumnStore": {
            "type": "boolean"
          },
          "FillFactor": {
            "type": "integer",
            "minimum": 0.0,
            "maximum": 100.0
          },
          "IncludeColumns": {
            "type": "string"
          },
          "UpdateFillFactor": {
            "type": "boolean"
          },
          "FileGroup": {
            "type": "string"
          },
          "IgnoreDuplicateKey": {
            "type": "boolean"
          },
          "PadIndex": {
            "type": "boolean"
          },
          "PartitionScheme": {
            "type": "string"
          },
          "XmlCompression": {
            "type": "boolean",
            "description": "SQL Server 2022+. Compresses XML column data in place. Sibling of CompressionType (DATA_COMPRESSION), and independent of it. **Deployable from 2022, but only EXTRACTABLE from 2025** — sys.partitions.xml_compression does not exist before then, so on 2022-2024 SchemaTongs carries the value forward from the package it is refreshing rather than dropping it."
          },
          "PartitionColumn": {
            "type": "string"
          },
          "BucketCount": {
            "type": "integer",
            "minimum": 1.0,
            "description": "BUCKET_COUNT for a HASH index on a memory-optimized table. Required for a hash index, ignored elsewhere. SQL Server rounds it up to the next power of two."
          },
          "Extensions": {}
        },
        "additionalProperties": false,
        "required": [
          "Name"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "ColumnStore": {
                  "const": true
                }
              },
              "required": [
                "ColumnStore"
              ]
            },
            "else": {
              "required": [
                "IndexColumns"
              ]
            }
          }
        ]
      }
    },
    "Extensions": {}
  },
  "additionalProperties": false,
  "required": [
    "Name",
    "Definition"
  ]
}