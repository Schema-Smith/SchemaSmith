{
  "$schema": "../../.json-schemas/templates.sqlserver.schema",
  "Name": "Sakila",
  "DatabaseIdentificationScript": "SELECT name FROM master.sys.databases WHERE name = '{{SakilaDb}}'",
  "ScriptFolders": [
    {
      "FolderPath": "Functions",
      "QuenchSlot": "Objects",
      "ObjectType": "Functions"
    },
    {
      "FolderPath": "Procedures",
      "QuenchSlot": "Objects",
      "ObjectType": "Procedures"
    },
    {
      "FolderPath": "Views",
      "QuenchSlot": "Objects",
      "ObjectType": "Views"
    },
    {
      "FolderPath": "Views-Modern",
      "QuenchSlot": "Objects",
      "ObjectType": "Views",
      "ShouldApplyExpression": "{{ServerMajorVersion}} >= 14 AND {{CompatibilityLevel}} >= 130"
    },
    {
      "FolderPath": "Views-Legacy",
      "QuenchSlot": "Objects",
      "ObjectType": "Views",
      "ShouldApplyExpression": "{{ServerMajorVersion}} < 14 OR {{CompatibilityLevel}} < 130"
    },
    {
      "FolderPath": "Triggers",
      "QuenchSlot": "AfterTablesObjects",
      "ObjectType": "Triggers"
    }
  ]
}