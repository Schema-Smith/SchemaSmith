{
  "$schema": ".json-schemas/products.sqlserver.schema",
  "Name": "Chinook",
  "MinimumVersion": "2016",
  "ValidationScript": "SELECT CASE WHEN EXISTS(SELECT * FROM master.sys.databases WHERE name IN ('{{ChinookDb}}', 'TestMain')) THEN 1 ELSE 0 END",
  "TemplateOrder": [
    "Initialize",
    "Chinook"
  ],
  "ScriptTokens": {
    "ChinookDb": "Chinook"
  },
  "ScriptFolders": [],
  "BranchNameFile": "{{repo_path}}/.git/HEAD",
  "BeforeBranchNameMask": "ref: refs/heads/",
  "AfterBranchNameMask": "",
  "Platform": "SqlServer"
}