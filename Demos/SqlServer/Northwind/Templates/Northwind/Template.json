{
  "$schema": "../../.json-schemas/templates.sqlserver.schema",
  "Name": "Northwind",
  "DatabaseIdentificationScript": "SELECT name FROM master.sys.databases WHERE name = '{{NorthwindDb}}'",
  "ScriptFolders": [
    {
      "FolderPath": "Schemas",
      "QuenchSlot": "Objects",
      "ObjectType": "Schemas"
    },
    {
      "FolderPath": "Views",
      "QuenchSlot": "Objects",
      "ObjectType": "Views"
    },
    {
      "FolderPath": "Procedures",
      "QuenchSlot": "Objects",
      "ObjectType": "Procedures"
    },
    {
      "FolderPath": "Procedures-Modern",
      "QuenchSlot": "Objects",
      "ObjectType": "Procedures",
      "ShouldApplyExpression": "{{ServerMajorVersion}} >= 14 AND {{CompatibilityLevel}} >= 130"
    },
    {
      "FolderPath": "Procedures-Legacy",
      "QuenchSlot": "Objects",
      "ObjectType": "Procedures",
      "ShouldApplyExpression": "{{ServerMajorVersion}} < 14 OR {{CompatibilityLevel}} < 130"
    }
  ]
}