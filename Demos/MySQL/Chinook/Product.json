{
  "$schema": ".json-schemas/products.mysql.schema",
  "Name": "Chinook",
  "MinimumVersion": "8.0",
  "ValidationScript": "SELECT EXISTS(SELECT * FROM information_schema.schemata WHERE SCHEMA_NAME IN ('{{ChinookDb}}', 'TestMain'))",
  "TemplateOrder": [
    "Initialize",
    "Chinook"
  ],
  "ScriptTokens": {
    "ChinookDb": "Chinook"
  },
  "ScriptFolders": [],
  "BranchNameFile": "{{repo_path}}/.git/HEAD",
  "BeforeBranchNameMask": "ref: refs/heads/",
  "AfterBranchNameMask": "",
  "Platform": "MySQL"
}