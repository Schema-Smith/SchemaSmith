{
  "$schema": "../../.json-schemas/templates.mysql.schema",
  "Name": "Northwind",
  "DatabaseIdentificationScript": "SELECT SCHEMA_NAME FROM information_schema.schemata WHERE SCHEMA_NAME = '{{NorthwindDb}}'",
  "ScriptFolders": [
    {
      "FolderPath": "Before Scripts",
      "QuenchSlot": "Before"
    },
    {
      "FolderPath": "Procedures",
      "QuenchSlot": "Objects",
      "ObjectType": "Procedures"
    },
    {
      "FolderPath": "Views",
      "QuenchSlot": "AfterTablesObjects",
      "ObjectType": "Views"
    },
    {
      "FolderPath": "After Scripts",
      "QuenchSlot": "After"
    }
  ]
}