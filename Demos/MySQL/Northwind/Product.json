{
  "$schema": ".json-schemas/products.mysql.schema",
  "Name": "Northwind",
  "MinimumVersion": "8.0",
  "ValidationScript": "SELECT EXISTS(SELECT * FROM information_schema.schemata WHERE SCHEMA_NAME IN ('{{NorthwindDb}}', 'TestMain'))",
  "TemplateOrder": [
    "Initialize",
    "Northwind"
  ],
  "ScriptTokens": {
    "NorthwindDb": "northwind"
  },
  "ScriptFolders": [],
  "BranchNameFile": "{{repo_path}}/.git/HEAD",
  "BeforeBranchNameMask": "ref: refs/heads/",
  "AfterBranchNameMask": "",
  "Platform": "MySQL"
}