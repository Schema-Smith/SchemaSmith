PostGreSQL_PORT=5432

# PostgreSQL image the demo runs on. Override to exercise the demo against a
# different server version — e.g. POSTGRES_IMAGE="postgis/postgis:12-3.4".
# Must be a PostGIS-enabled image: the demo deploys spatial columns, so a plain
# postgres:<n> tag will fail. PostGIS tags are <pgMajor>-<postgisVersion>.
POSTGRES_IMAGE="postgis/postgis:latest"