{
    "Source": {
        "Server": "",
        "User": "", // SQL Server: leave User and Password blank for Windows authentication
        "Password": "",
        "Database": "",
        "Schema": "", // Mirrors DataTongs Source.Schema for round-trip symmetry. SQL Server / PostgreSQL only —
                  // when set, activates schema-template extraction mode (see Template.SchemaIdentificationScript).
                  // On MySQL (where schema = database), Source.Schema is accepted as a fallback for
                  // Source.Database, but Source.Database is preferred.
        "Port": "", // Optional for all platforms — overrides default port
        "Platform": "", // SqlServer, PostgreSQL, MySQL, or MariaDb
        // "IntegratedSecurity": true, // SQL Server: use Windows Authentication and IGNORE any
                                       // User/Password above — for when a credential is present
                                       // but should not be used.
        // "CompatEncoding": "", // Override the payload encoding chosen for the source server
                                 // (Json | Xml). Blank = choose automatically.
        "ConnectionProperties": {
            "TrustServerCertificate": "True" // Trust self-signed certificates (recommended for development)
        }
    },
    // Name will default to the last folder in the product path if not provided.
    // Name is used for the new product if one is created and will not rename an existing one.
    "Product": {
        "Path": "",
        "Name": "",
        "CheckConstraintStyle": "" // ColumnLevel (default) or TableLevel — for new products only; existing products use Product.json value
        // "ObjectOrder": "Name", // Sequence for a table's object lists when there is nothing to preserve: Name (default, alphabetical) or Physical (the table's own column order)
        // "PreserveExistingOrder": true // On re-extract, keep the order the file being replaced already had for entries still present, append new ones, drop what's gone (default true)
    },
    "TemplatePath": "", // Where the template directory is written. Blank = under Product.Path.
    // Name will default to Database if not provided.
    // This becomes the folder name for the template that is exported as well as the template name.
    "Template": {
        "Name": "",
        "SchemaIdentificationScript": "" // Optional. Used only when Source.Schema is set. Written into the
                                         // generated Template.json verbatim. When blank, a stub script that
                                         // returns the source schema as a single row is generated so the
                                         // extracted package quench-tests immediately.
    },
    "ShouldCast": {
        // All platforms
        "Tables": true,
        "Views": true,
        "ObjectList": "", // Comma-separated list of specific objects to extract (blank = all)
        "ValidateScripts": false, // Validate extracted scripts against the source database
        "SaveInvalidScripts": true, // Save invalid scripts as .sqlerror files (if false, invalid scripts are discarded)
        "ScriptDynamicDependencyRemovalForFunctions": false,

        // SQL Server and PostgreSQL
        "Schemas": true,

        // SQL Server only
        "UserDefinedTypes": true,
        "Catalogs": true, // Full-Text Catalogs
        "StopLists": true, // Full-Text Stop Lists
        "DDLTriggers": true,
        "XMLSchemaCollections": true,
        "IndexedViews": true, // SQL Server only — indexed views
        "Synonyms": true,

        // PostgreSQL only
        "DomainTypes": true,
        "EnumTypes": true,
        "CompositeTypes": true,
        "Aggregates": true,
        "Sequences": true,
        "Rules": true,
        "MaterializedViews": true,
        "Collations": true, // CREATE COLLATION objects
        "Publications": true, // Logical-replication publications

        // All platforms
        "Functions": true,
        "Procedures": true,
        "TableTriggers": true,

        // MySQL only
        "Events": true
    },
    "OrphanHandling": {
        "Mode": "Detect" // Detect, DetectWithCleanupScripts, or DetectDeleteAndCleanup
    },
    "FolderMapping": {
        // Optional — rename the default folder for any extracted object type. Defaults shown below; omit or remove any entry to use the platform default.
        // SQL Server defaults (active)
        "Schemas": "Schemas",
        "DataTypes": "DataTypes",
        "FullTextCatalogs": "FullTextCatalogs",
        "FullTextStopLists": "FullTextStopLists",
        "XMLSchemaCollections": "XMLSchemaCollections",
        "Functions": "Functions",
        "Views": "Views",
        "Procedures": "Procedures",
        "Triggers": "Triggers",
        "DDLTriggers": "DDLTriggers"
        // PostgreSQL-specific defaults (uncomment and replace SQL Server entries as needed):
        //   "DomainTypes": "Domain Types"
        //   "EnumTypes": "Enum Types"
        //   "CompositeTypes": "Composite Types"
        //   "TriggerFunctions": "Trigger Functions"
        //   "WindowFunctions": "Window Functions"
        //   "Aggregates": "Aggregates"
        //   "Sequences": "Sequences"
        //   "Rules": "Rules"
        // MySQL-specific defaults (uncomment and replace SQL Server entries as needed):
        //   "Events": "Events"
    },
    "LogHygiene": {
        // Optional — extra value names to scrub from logs, beyond the built-in sensitive-name list.
        // Keys are matched case-insensitively against setting and token names.
        // "ApiKey": true
    },
    "ScriptTokens": {} // Token values substituted into extracted scripts, e.g. { "MainDB": "AppDb" }.
}
